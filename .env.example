# ==========================================
# Det 7:e Gunget - Environment Configuration
# ==========================================

# 1. Database (Turso / LibSQL)
# For local dev: file:local.db
# For production: libsql://det-sjunde-gunget-<org>.turso.io
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# 2. Vercel Blob Storage (for photo uploads in production)
BLOB_READ_WRITE_TOKEN=

# 3. Social Authentication (Google, GitHub & Facebook OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# 4. Newsletter & Booking Notifications (Brevo / Sendinblue)
BREVO_API_KEY=
BREVO_CONTACT_EMAIL=kontakt@det7egunget.se